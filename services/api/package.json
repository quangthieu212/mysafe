{
  "name": "@ket-sat-viet/api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:contract": "tsx --test test/contract.test.ts",
    "test:unit": "tsx --test test/*.unit.test.ts",
    "test:db": "tsx --test test/postgres.integration.test.ts",
    "check": "npm run build && npm run test:contract && npm run test:unit && npm run test:db"
  },
  "dependencies": {
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
